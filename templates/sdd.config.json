{
  "project": {
    "name": "my-project",
    "description": "One line: what the project is and what it is not (research prototype, production service, library).",
    "languages": [],
    "threat_model": "State what is untrusted (every byte from a peer/client/file), what must never happen (crash, hang, memory exhaustion, secret leak into logs/diagnostics), and what is deliberately out of scope (e.g. test fixtures are not secrets; do not re-implement mature libraries to zeroize transient buffers)."
  },
  "paths": {
    "features_dir": "specs/features",
    "templates_dir": "specs/templates",
    "roadmap": "docs/ROADMAP.md",
    "constitution": "docs/CONSTITUTION.md",
    "development": "docs/DEVELOPMENT.md",
    "logs_dir": ".sdd/logs",
    "worktree_root": ".wt",
    "build_dirs": ["build", "dist", "target"],
    "tools_dir": "tools/sdd"
  },
  "features": {
    "id_prefix": "F",
    "id_digits": 3,
    "branch_prefix": "feat/",
    "roadmap_milestone_regex": "^###\\s+(M\\d+)\\s*[—–-]+\\s*(.+?)\\s*$",
    "roadmap_feature_regex": "^####\\s+(F\\d{3})\\s+(\\S+)(.*)$",
    "done_without_spec": []
  },
  "requirements": {
    "id_regex": "(?:STD\\d+-[0-9A-Z.]+|PRJ-[A-Z0-9]+)-R\\d{2,3}",
    "priorities": ["must", "should", "may"],
    "block_size": 10,
    "budget": {"min": 15, "max": 45},
    "clarification_marker": "[NEEDS CLARIFICATION:",
    "statuses": ["Draft", "Approved", "Implemented"],
    "enforce_for_statuses": ["Implemented"],
    "require_impl_for_statuses": ["Implemented"]
  },
  "trace": {
    "scan_globs": ["src/**/*", "lib/**/*", "pkg/**/*", "packages/**/*", "tests/**/*", "test/**/*"],
    "exclude_globs": ["**/target/**", "**/node_modules/**", "**/.git/**", "**/dist/**", "**/build/**", "**/.venv/**"],
    "implements_keywords": ["Implements"],
    "verifies_keywords": ["Verifies"],
    "attribute_forms": true,
    "procedure_steps": {
      "enabled": false,
      "statuses": ["Approved", "Implemented"],
      "source_check": true,
      "label_regex": ""
    }
  },
  "components": {
    "path_regex": "^(?:packages|services|apps|pkg)/([^/]+)/",
    "root": "repository",
    "word": "component"
  },
  "gates": {
    "fast": [
      {"name": "fmt", "command": "sh -c 'echo \"gate fmt not configured: set gates.fast in sdd.config.json (see docs/ADAPTING.md)\" >&2; exit 2'", "timeout": 120},
      {"name": "lint", "command": "sh -c 'echo \"gate lint not configured: set gates.fast in sdd.config.json (see docs/ADAPTING.md)\" >&2; exit 2'", "timeout": 1200},
      {"name": "test", "command": "sh -c 'echo \"gate test not configured: set gates.fast in sdd.config.json (see docs/ADAPTING.md)\" >&2; exit 2'", "timeout": 1800},
      {"name": "trace", "command": "python3 -I tools/sdd/sdd.py trace --check", "timeout": 60},
      {"name": "size", "command": "python3 -I tools/sdd/sdd.py check size", "timeout": 600, "skip_exit": 3},
      {"name": "arch", "command": "python3 -I tools/sdd/sdd.py check arch", "timeout": 600, "skip_exit": 3},
      {"name": "baseline", "command": "python3 -I tools/sdd/sdd.py check baseline", "timeout": 600, "skip_exit": 3},
      {"name": "commits", "command": "python3 -I tools/sdd/sdd.py check commits", "timeout": 600, "skip_exit": 3},
      {"name": "secrets", "command": "python3 -I tools/sdd/sdd.py check secrets", "timeout": 600, "skip_exit": 3}
    ],
    "full": [
      {"name": "fmt", "command": "sh -c 'echo \"gate fmt not configured: set gates.full in sdd.config.json (see docs/ADAPTING.md)\" >&2; exit 2'", "timeout": 120},
      {"name": "lint", "command": "sh -c 'echo \"gate lint not configured: set gates.full in sdd.config.json (see docs/ADAPTING.md)\" >&2; exit 2'", "timeout": 1200},
      {"name": "test", "command": "sh -c 'echo \"gate test not configured: set gates.full in sdd.config.json (see docs/ADAPTING.md)\" >&2; exit 2'", "timeout": 3600},
      {"name": "trace", "command": "python3 -I tools/sdd/sdd.py trace --check", "timeout": 60},
      {"name": "audit", "command": "sh -c 'echo \"gate audit not configured: dependency audit for your language (see docs/ADAPTING.md)\" >&2; exit 2'", "timeout": 600, "optional": true},
      {"name": "size", "command": "python3 -I tools/sdd/sdd.py check size", "timeout": 600, "skip_exit": 3},
      {"name": "arch", "command": "python3 -I tools/sdd/sdd.py check arch", "timeout": 600, "skip_exit": 3},
      {"name": "baseline", "command": "python3 -I tools/sdd/sdd.py check baseline", "timeout": 600, "skip_exit": 3},
      {"name": "commits", "command": "python3 -I tools/sdd/sdd.py check commits", "timeout": 600, "skip_exit": 3},
      {"name": "secrets", "command": "python3 -I tools/sdd/sdd.py check secrets", "timeout": 600, "skip_exit": 3},
      {"name": "protected", "command": "python3 -I tools/sdd/sdd.py check protected", "timeout": 600, "skip_exit": 3},
      {"name": "coverage", "command": "python3 -I tools/sdd/sdd.py check coverage", "timeout": 3600, "skip_exit": 3},
      {"name": "mutation", "command": "python3 -I tools/sdd/sdd.py check mutation", "timeout": 3600, "skip_exit": 3}
    ],
    "nightly": []
  },
  "quality": {
    "baseline_file": "sdd.baseline.json",
    "base_ref": "",
    "generated": [],
    "test_globs": [],
    "languages": {},
    "tool_dirs": [],
    "size": {"globs": [], "exclude": [], "function_warn": 0, "function_fail": 80, "file_warn": 600, "file_fail": 1000},
    "arch": {"modules": [], "exclude": ["tests/**", "**/tests/**", "test/**", "**/test/**"]},
    "coverage": {
      "command": "",
      "report": "",
      "format": "lcov",
      "globs": [],
      "unmeasured_ok": [],
      "ok_exits": [0],
      "requires": [],
      "install": "",
      "timeout": 3600
    },
    "mutation": {
      "command": "",
      "report": "",
      "format": "regex",
      "survivor_regex": "",
      "ok_exits": [0],
      "globs": [],
      "requires": [],
      "install": "",
      "timeout": 3600,
      "jobs": 2,
      "test_threads": 3,
      "memory_limit_mib": 2048,
      "env": {}
    },
    "heavy_lock": ".wt/locks/heavy.lock",
    "heavy_budget_mb": 0,
    "heavy_job_mb": 0,
    "heavy_job_mb_by_command": [],
    "checks": [],
    "secrets": {"gitleaks": true, "patterns": [], "allow_globs": []},
    "hooks": {
      "types": ["build", "chore", "ci", "docs", "feat", "fix", "perf", "refactor", "revert", "style", "test"],
      "scope_regex": "",
      "required_trailers": ["^Co-Authored-By: .+ <.+>$"],
      "required_trailers_env": "CLAUDECODE",
      "trailer_authors": "",
      "pre_commit": [],
      "commit_tests": true,
      "skip_tests_for_types": ["test"],
      "test_timeout": 300,
      "budget_seconds": 60
    }
  },
  "tests": {
    "run": "sh -c 'echo \"tests.run not configured in sdd.config.json\" >&2; exit 2'",
    "run_component": "",
    "red_check": ""
  },
  "sources": {
    "kind": "product-requirements",
    "description": "docs/REQUIREMENTS.md is the normative source; sections are numbered.",
    "citation_format": "(Source: REQUIREMENTS §<section>)",
    "lookup_command": "",
    "text_dir": "docs/requirements",
    "heading_regex": "^#+\\s+{clause}\\b"
  },
  "protected_paths": [
    {"glob": "docs/CONSTITUTION.md", "reason": "the constitution changes only via a human-approved ADR"},
    {"glob": ".claude/**", "reason": "agent, skill, hook and workflow configuration is human-owned"},
    {"glob": "sdd.config.json", "reason": "the SDD configuration is human-owned"},
    {"glob": "docs/requirements/**", "reason": "the normative source is read-only"}
  ],
  "append_only_paths": [
    {"glob": "**/tests/fixtures/**", "allowed_roles": ["test-author"], "reason": "fixtures and golden vectors are immutable; test-author may only add NEW files with provenance"}
  ],
  "role_write_scopes": {
    "spec-author": ["specs/features/**"],
    "architect-planner": ["specs/features/**"],
    "product-owner": ["specs/features/**"],
    "integrator": ["specs/features/**", "package-lock.json", "Cargo.lock", "go.sum", "poetry.lock", "uv.lock"]
  },
  "role_denied_paths": {
    "implementer": ["**/tests/**", "**/test/**", "**/*_test.*", "**/*.test.*", "**/test_*.py", "tools/sdd/githooks/**", "tools/sdd/sddkit/**", "tools/sdd/sdd.py"],
    "test-author": ["tools/sdd/githooks/**", "tools/sdd/sddkit/**", "tools/sdd/sdd.py"]
  },
  "formatters": [],
  "build_cache": {
    "env": {}
  },
  "stop_check": {
    "command": "",
    "changed_globs": [],
    "roles": ["implementer"],
    "timeout": 240,
    "nice": 10,
    "env": {}
  },
  "_models_example": {
    "_comment": "The default efficient mapping (README \"Model routing\"). Copy the tiers into \"models\" with your provider's explicit model ids (never aliases); \"\" inherits the session model. effort is one of low|medium|high|xhigh|max or \"\" (the call site decides); the highest efforts are never defaults.",
    "mechanical": "<cheapest-model-id>",
    "gate": {"id": "<small-model-id>", "effort": "medium"},
    "mid": {"id": "<mid-model-id>", "effort": "medium"},
    "strong": {"id": "<top-model-id>", "effort": "medium"},
    "top": {"id": "<top-model-id>", "effort": "high"}
  },
  "models": {
    "mechanical": "",
    "gate": "",
    "mid": "",
    "strong": "",
    "top": ""
  },
  "pipeline": {
    "max_parallel_features": 2,
    "max_critic_fix_rounds": 2,
    "max_gate_fix_rounds": 3,
    "skeptics": 2,
    "max_build_jobs": 4,
    "gate_poll_seconds": 120,
    "routing": "tiers",
    "models_table": "sdd.models.json",
    "security_sensitive_hint": "authentication, authorization, cryptography, secrets, session or token handling, parsing of untrusted input"
  },
  "merge": {
    "union_manifests": ["package.json", "go.mod", "pyproject.toml", "Cargo.toml"],
    "lockfiles": ["package-lock.json", "Cargo.lock", "go.sum", "poetry.lock", "uv.lock"],
    "after_union": ""
  },
  "commit": {
    "trailers": ["Co-Authored-By: <agent name> <noreply@example.com>"],
    "scope_format": "{feature}"
  },
  "override_env": "SDD_ALLOW_PROTECTED"
}
