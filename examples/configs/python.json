{
  "project": {
    "name": "python-project",
    "description": "",
    "languages": [
      "python"
    ],
    "threat_model": "State what is untrusted (every byte from a peer/client/file), what must never happen (crash, hang, memory exhaustion, secret leak into logs/diagnostics), and what is deliberately out of scope (e.g. test fixtures are not secrets; do not re-implement mature libraries to zeroize transient buffers)."
  },
  "paths": {
    "features_dir": "specs/features",
    "templates_dir": "specs/templates",
    "roadmap": "docs/ROADMAP.md",
    "constitution": "docs/CONSTITUTION.md",
    "development": "docs/DEVELOPMENT.md",
    "logs_dir": ".sdd/logs",
    "worktree_root": ".wt",
    "build_dirs": [
      ".venv",
      ".mypy_cache",
      ".pytest_cache",
      "build",
      "dist"
    ],
    "tools_dir": "tools/sdd"
  },
  "features": {
    "id_prefix": "F",
    "id_digits": 3,
    "branch_prefix": "feat/",
    "roadmap_milestone_regex": "^###\\s+(M\\d+)\\s*[—–-]+\\s*(.+?)\\s*$",
    "roadmap_feature_regex": "^####\\s+(F\\d{3})\\s+(\\S+)(.*)$",
    "done_without_spec": []
  },
  "requirements": {
    "id_regex": "(?:STD\\d+-[0-9A-Z.]+|PRJ-[A-Z0-9]+)-R\\d{2,3}",
    "priorities": [
      "must",
      "should",
      "may"
    ],
    "block_size": 10,
    "budget": {
      "min": 15,
      "max": 45
    },
    "clarification_marker": "[NEEDS CLARIFICATION:",
    "statuses": [
      "Draft",
      "Approved",
      "Implemented"
    ],
    "enforce_for_statuses": [
      "Implemented"
    ],
    "require_impl_for_statuses": [
      "Implemented"
    ]
  },
  "trace": {
    "scan_globs": [
      "src/**/*.py",
      "tests/**/*.py"
    ],
    "exclude_globs": [
      "**/target/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**"
    ],
    "implements_keywords": [
      "Implements"
    ],
    "verifies_keywords": [
      "Verifies"
    ],
    "attribute_forms": true
  },
  "components": {
    "path_regex": "^src/([^/]+)/",
    "root": "workspace",
    "word": "package"
  },
  "gates": {
    "fast": [
      {
        "name": "fmt",
        "command": "ruff format --check --extend-exclude tools/sdd .",
        "timeout": 120
      },
      {
        "name": "lint",
        "command": "ruff check --extend-exclude tools/sdd .",
        "timeout": 300
      },
      {
        "name": "typecheck",
        "command": "mypy src",
        "timeout": 600,
        "optional": true,
        "skip_if_missing": "mypy"
      },
      {
        "name": "test",
        "command": "pytest -q -x --no-header",
        "timeout": 1200
      },
      {
        "name": "trace",
        "command": "python3 -I tools/sdd/sdd.py trace --check",
        "timeout": 60
      },
      {
        "name": "size",
        "command": "python3 -I tools/sdd/sdd.py check size",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "arch",
        "command": "python3 -I tools/sdd/sdd.py check arch",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "baseline",
        "command": "python3 -I tools/sdd/sdd.py check baseline",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "commits",
        "command": "python3 -I tools/sdd/sdd.py check commits",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "secrets",
        "command": "python3 -I tools/sdd/sdd.py check secrets",
        "timeout": 600,
        "skip_exit": 3
      }
    ],
    "full": [
      {
        "name": "fmt",
        "command": "ruff format --check --extend-exclude tools/sdd .",
        "timeout": 120
      },
      {
        "name": "lint",
        "command": "ruff check --extend-exclude tools/sdd .",
        "timeout": 300
      },
      {
        "name": "typecheck",
        "command": "mypy src",
        "timeout": 600,
        "optional": true,
        "skip_if_missing": "mypy"
      },
      {
        "name": "test",
        "command": "pytest -q --no-header --cov=src --cov-fail-under=80",
        "timeout": 3600
      },
      {
        "name": "trace",
        "command": "python3 -I tools/sdd/sdd.py trace --check",
        "timeout": 60
      },
      {
        "name": "audit",
        "command": "pip-audit",
        "timeout": 600,
        "optional": true,
        "skip_if_missing": "pip-audit"
      },
      {
        "name": "property",
        "command": "pytest -q -m property --hypothesis-profile=ci",
        "timeout": 1800,
        "optional": true
      },
      {
        "name": "bench",
        "command": "pytest -q benchmarks --benchmark-compare=baseline --benchmark-compare-fail=mean:5%",
        "timeout": 1800,
        "optional": true
      },
      {
        "name": "size",
        "command": "python3 -I tools/sdd/sdd.py check size",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "arch",
        "command": "python3 -I tools/sdd/sdd.py check arch",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "baseline",
        "command": "python3 -I tools/sdd/sdd.py check baseline",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "commits",
        "command": "python3 -I tools/sdd/sdd.py check commits",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "secrets",
        "command": "python3 -I tools/sdd/sdd.py check secrets",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "coverage",
        "command": "python3 -I tools/sdd/sdd.py check coverage",
        "timeout": 3600,
        "skip_exit": 3
      },
      {
        "name": "mutation",
        "command": "python3 -I tools/sdd/sdd.py check mutation",
        "timeout": 3600,
        "skip_exit": 3
      },
      {
        "name": "docs",
        "command": "python3 -I tools/sdd/sdd.py check docs",
        "timeout": 1800,
        "skip_exit": 3
      },
      {
        "name": "unused-deps",
        "command": "python3 -I tools/sdd/sdd.py check unused-deps",
        "timeout": 1800,
        "skip_exit": 3
      },
      {
        "name": "flaky",
        "command": "python3 -I tools/sdd/sdd.py check flaky",
        "timeout": 1800,
        "skip_exit": 3
      }
    ],
    "nightly": [
      {
        "name": "coverage-full",
        "command": "coverage run --source=src -m pytest -q && coverage report --fail-under=90",
        "timeout": 7200,
        "skip_if_missing": "coverage"
      },
      {
        "name": "mutation-full",
        "command": "mutmut run",
        "timeout": 21600,
        "skip_if_missing": "mutmut"
      }
    ]
  },
  "quality": {
    "baseline_file": "sdd.baseline.json",
    "base_ref": "",
    "generated": [],
    "test_globs": [],
    "languages": {},
    "size": {
      "globs": [],
      "exclude": [
        "**/.venv/**"
      ],
      "function_warn": 0,
      "function_fail": 80,
      "file_warn": 600,
      "file_fail": 1000
    },
    "arch": {
      "modules": [
        {
          "name": "domain",
          "paths": [
            "src/app/domain/**"
          ],
          "imports": [
            "^app\\.domain\\b"
          ],
          "may_depend_on": [],
          "forbid": [
            {
              "pattern": "^\\s*(import|from)\\s+requests\\b",
              "reason": "the domain does no I/O"
            },
            {
              "pattern": "\\brequests\\.",
              "reason": "the domain does no I/O"
            },
            {
              "pattern": "\\bdatetime\\.now\\(",
              "reason": "domain logic takes time as input"
            }
          ]
        },
        {
          "name": "infra",
          "paths": [
            "src/app/infra/**"
          ],
          "imports": [
            "^app\\.infra\\b"
          ],
          "may_depend_on": [
            "domain"
          ],
          "forbid": []
        }
      ],
      "exclude": [
        "tests/**",
        "**/tests/**",
        "test/**",
        "**/test/**"
      ]
    },
    "coverage": {
      "command": "coverage run --source=src -m pytest -q && coverage lcov -o lcov.info",
      "report": "lcov.info",
      "format": "lcov",
      "globs": [],
      "unmeasured_ok": [],
      "ok_exits": [
        0
      ],
      "requires": [
        "coverage",
        "pytest"
      ],
      "install": "pip install coverage pytest",
      "timeout": 3600
    },
    "mutation": {
      "command": "mutmut run --max-children 4 >/dev/null && mutmut results",
      "report": "",
      "format": "regex",
      "survivor_regex": "(?m)^\\s+(?P<file>[\\w.]+?)\\.(?P<mutation>x\\w*__mutmut_\\d+): survived$",
      "ok_exits": [
        0
      ],
      "globs": [],
      "requires": [
        "mutmut"
      ],
      "install": "pip install mutmut",
      "timeout": 3600
    },
    "checks": [
      {
        "name": "docs",
        "command": "ruff check --select D --output-format concise src",
        "violation_regex": "(?m)^(?P<file>[^:\\n]+\\.py):(?P<line>\\d+):\\d+: (?P<message>D\\d{3} .+)$",
        "baseline": true,
        "requires": [
          "ruff"
        ],
        "install": "pip install ruff",
        "timeout": 600,
        "ok_exits": [
          0,
          1
        ]
      },
      {
        "name": "unused-deps",
        "command": "deptry src",
        "violation_regex": "(?m)^(?P<file>[^:\\n]+)(?::(?P<line>\\d+):\\d+)?: (?P<message>DEP\\d{3} .+)$",
        "baseline": true,
        "requires": [
          "deptry"
        ],
        "install": "pip install deptry",
        "timeout": 600,
        "ok_exits": [
          0,
          1
        ]
      },
      {
        "name": "flaky",
        "command": "python3 -c 'import pytest_rerunfailures' 2>/dev/null || exit 127; pytest -q -p rerunfailures --reruns 2 -rR",
        "violation_regex": "(?m)^RERUN (?P<file>[^:\\s]+)::(?P<message>\\S+)",
        "baseline": false,
        "requires": [
          "pytest"
        ],
        "install": "pip install pytest pytest-rerunfailures",
        "timeout": 3600,
        "ok_exits": [
          0,
          1
        ]
      }
    ],
    "secrets": {
      "gitleaks": true,
      "patterns": [],
      "allow_globs": []
    },
    "hooks": {
      "types": [
        "build",
        "chore",
        "ci",
        "docs",
        "feat",
        "fix",
        "perf",
        "refactor",
        "revert",
        "style",
        "test"
      ],
      "scope_regex": "",
      "required_trailers": [
        "^Co-Authored-By: .+ <.+>$"
      ],
      "required_trailers_env": "CLAUDECODE",
      "trailer_authors": "",
      "pre_commit": [
        {
          "name": "ruff-format",
          "command": "ruff format --check {files}",
          "glob": "*.py",
          "timeout": 60
        }
      ],
      "commit_tests": true,
      "skip_tests_for_types": [
        "test"
      ],
      "test_timeout": 300,
      "budget_seconds": 60
    }
  },
  "tests": {
    "run": "pytest -q --no-header",
    "run_component": "pytest -q --no-header tests/{component}",
    "red_check": ""
  },
  "sources": {
    "kind": "product-requirements",
    "description": "docs/REQUIREMENTS.md is the normative source; sections are numbered.",
    "citation_format": "(Source: REQUIREMENTS §<section>)",
    "lookup_command": "",
    "text_dir": "docs/requirements",
    "heading_regex": "^#+\\s+{clause}\\b"
  },
  "protected_paths": [
    {
      "glob": "docs/CONSTITUTION.md",
      "reason": "the constitution changes only via a human-approved ADR"
    },
    {
      "glob": ".claude/**",
      "reason": "agent, skill, hook and workflow configuration is human-owned"
    },
    {
      "glob": "sdd.config.json",
      "reason": "the SDD configuration is human-owned"
    },
    {
      "glob": "docs/requirements/**",
      "reason": "the normative source is read-only"
    }
  ],
  "append_only_paths": [
    {
      "glob": "tests/fixtures/**",
      "allowed_roles": [
        "test-author"
      ],
      "reason": "fixtures are immutable; test-author may only add NEW files with provenance"
    }
  ],
  "role_write_scopes": {
    "spec-author": [
      "specs/features/**"
    ],
    "architect-planner": [
      "specs/features/**"
    ],
    "product-owner": [
      "specs/features/**"
    ],
    "integrator": [
      "specs/features/**",
      "poetry.lock",
      "uv.lock",
      "requirements*.txt"
    ]
  },
  "role_denied_paths": {
    "implementer": [
      "tests/**",
      "**/test_*.py",
      "**/*_test.py",
      "**/conftest.py",
      "tools/sdd/githooks/**",
      "tools/sdd/sddkit/**",
      "tools/sdd/sdd.py"
    ],
    "test-author": [
      "tools/sdd/githooks/**",
      "tools/sdd/sddkit/**",
      "tools/sdd/sdd.py"
    ]
  },
  "formatters": [
    {
      "glob": "*.py",
      "command": "ruff format {file}",
      "exclude": [
        "**/.venv/**"
      ]
    }
  ],
  "build_cache": {
    "env": {}
  },
  "stop_check": {
    "command": "python3 -m compileall -q src",
    "changed_globs": [
      "*.py"
    ],
    "roles": [
      "implementer"
    ],
    "timeout": 120
  },
  "models": {
    "mechanical": "",
    "gate": "",
    "mid": "",
    "strong": "",
    "top": ""
  },
  "pipeline": {
    "max_parallel_features": 2,
    "max_critic_fix_rounds": 2,
    "max_gate_fix_rounds": 3,
    "skeptics": 2,
    "max_build_jobs": 4,
    "gate_poll_seconds": 120,
    "routing": "tiers",
    "models_table": "sdd.models.json",
    "security_sensitive_hint": "authentication, authorization, cryptography, secrets, session or token handling, parsing of untrusted input"
  },
  "merge": {
    "union_manifests": [
      "pyproject.toml"
    ],
    "lockfiles": [
      "poetry.lock",
      "uv.lock"
    ],
    "after_union": "uv lock >/dev/null 2>&1 || poetry lock --no-update >/dev/null 2>&1 || true"
  },
  "commit": {
    "trailers": [
      "Co-Authored-By: <agent> <noreply@example.com>"
    ],
    "scope_format": "{feature}"
  },
  "override_env": "SDD_ALLOW_PROTECTED"
}
