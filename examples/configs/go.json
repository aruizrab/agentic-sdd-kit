{
  "project": {
    "name": "go-project",
    "description": "",
    "languages": [
      "go"
    ],
    "threat_model": "State what is untrusted (every byte from a peer/client/file), what must never happen (crash, hang, memory exhaustion, secret leak into logs/diagnostics), and what is deliberately out of scope (e.g. test fixtures are not secrets; do not re-implement mature libraries to zeroize transient buffers)."
  },
  "paths": {
    "features_dir": "specs/features",
    "templates_dir": "specs/templates",
    "roadmap": "docs/ROADMAP.md",
    "constitution": "docs/CONSTITUTION.md",
    "development": "docs/DEVELOPMENT.md",
    "logs_dir": ".sdd/logs",
    "worktree_root": ".wt",
    "build_dirs": [
      "bin",
      ".gocache"
    ],
    "tools_dir": "tools/sdd"
  },
  "features": {
    "id_prefix": "F",
    "id_digits": 3,
    "branch_prefix": "feat/",
    "roadmap_milestone_regex": "^###\\s+(M\\d+)\\s*[—–-]+\\s*(.+?)\\s*$",
    "roadmap_feature_regex": "^####\\s+(F\\d{3})\\s+(\\S+)(.*)$",
    "done_without_spec": []
  },
  "requirements": {
    "id_regex": "(?:STD\\d+-[0-9A-Z.]+|PRJ-[A-Z0-9]+)-R\\d{2,3}",
    "priorities": [
      "must",
      "should",
      "may"
    ],
    "block_size": 10,
    "budget": {
      "min": 15,
      "max": 45
    },
    "clarification_marker": "[NEEDS CLARIFICATION:",
    "statuses": [
      "Draft",
      "Approved",
      "Implemented"
    ],
    "enforce_for_statuses": [
      "Implemented"
    ],
    "require_impl_for_statuses": [
      "Implemented"
    ]
  },
  "trace": {
    "scan_globs": [
      "**/*.go"
    ],
    "exclude_globs": [
      "**/vendor/**",
      "**/.git/**",
      "**/bin/**"
    ],
    "implements_keywords": [
      "Implements"
    ],
    "verifies_keywords": [
      "Verifies"
    ],
    "attribute_forms": true
  },
  "components": {
    "path_regex": "^(?:internal|pkg|cmd)/([^/]+)/",
    "root": "module",
    "word": "package"
  },
  "gates": {
    "fast": [
      {
        "name": "fmt",
        "command": "test -z \"$(gofmt -l .)\"",
        "timeout": 120
      },
      {
        "name": "vet",
        "command": "go vet ./...",
        "timeout": 600
      },
      {
        "name": "lint",
        "command": "golangci-lint run ./...",
        "timeout": 900,
        "optional": true,
        "skip_if_missing": "golangci-lint"
      },
      {
        "name": "test",
        "command": "go test ./...",
        "timeout": 1800
      },
      {
        "name": "trace",
        "command": "python3 -I tools/sdd/sdd.py trace --check",
        "timeout": 60
      },
      {
        "name": "size",
        "command": "python3 -I tools/sdd/sdd.py check size",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "arch",
        "command": "python3 -I tools/sdd/sdd.py check arch",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "baseline",
        "command": "python3 -I tools/sdd/sdd.py check baseline",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "commits",
        "command": "python3 -I tools/sdd/sdd.py check commits",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "secrets",
        "command": "python3 -I tools/sdd/sdd.py check secrets",
        "timeout": 600,
        "skip_exit": 3
      }
    ],
    "full": [
      {
        "name": "fmt",
        "command": "test -z \"$(gofmt -l .)\"",
        "timeout": 120
      },
      {
        "name": "vet",
        "command": "go vet ./...",
        "timeout": 600
      },
      {
        "name": "lint",
        "command": "golangci-lint run ./...",
        "timeout": 900,
        "optional": true,
        "skip_if_missing": "golangci-lint"
      },
      {
        "name": "test",
        "command": "go test -race -cover ./...",
        "timeout": 3600
      },
      {
        "name": "trace",
        "command": "python3 -I tools/sdd/sdd.py trace --check",
        "timeout": 60
      },
      {
        "name": "vuln",
        "command": "govulncheck ./...",
        "timeout": 600,
        "optional": true,
        "skip_if_missing": "govulncheck"
      },
      {
        "name": "fuzz",
        "command": "scripts/fuzz-changed.sh 60s",
        "timeout": 1800,
        "optional": true
      },
      {
        "name": "bench",
        "command": "scripts/bench-compare.sh benches/baseline.txt 5",
        "timeout": 1800,
        "optional": true
      },
      {
        "name": "size",
        "command": "python3 -I tools/sdd/sdd.py check size",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "arch",
        "command": "python3 -I tools/sdd/sdd.py check arch",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "baseline",
        "command": "python3 -I tools/sdd/sdd.py check baseline",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "commits",
        "command": "python3 -I tools/sdd/sdd.py check commits",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "secrets",
        "command": "python3 -I tools/sdd/sdd.py check secrets",
        "timeout": 600,
        "skip_exit": 3
      },
      {
        "name": "coverage",
        "command": "python3 -I tools/sdd/sdd.py check coverage",
        "timeout": 3600,
        "skip_exit": 3
      },
      {
        "name": "mutation",
        "command": "python3 -I tools/sdd/sdd.py check mutation",
        "timeout": 3600,
        "skip_exit": 3
      },
      {
        "name": "docs",
        "command": "python3 -I tools/sdd/sdd.py check docs",
        "timeout": 1800,
        "skip_exit": 3
      },
      {
        "name": "unused-deps",
        "command": "python3 -I tools/sdd/sdd.py check unused-deps",
        "timeout": 1800,
        "skip_exit": 3
      },
      {
        "name": "flaky",
        "command": "python3 -I tools/sdd/sdd.py check flaky",
        "timeout": 1800,
        "skip_exit": 3
      }
    ],
    "nightly": [
      {
        "name": "coverage-full",
        "command": "go test -cover ./...",
        "timeout": 7200
      },
      {
        "name": "mutation-full",
        "command": "gremlins unleash ./...",
        "timeout": 21600,
        "skip_if_missing": "gremlins"
      }
    ]
  },
  "quality": {
    "baseline_file": "sdd.baseline.json",
    "base_ref": "",
    "generated": [
      "**/*.pb.go",
      "**/zz_generated*.go"
    ],
    "test_globs": [],
    "languages": {},
    "size": {
      "globs": [],
      "exclude": [],
      "function_warn": 0,
      "function_fail": 80,
      "file_warn": 600,
      "file_fail": 1000
    },
    "arch": {
      "modules": [
        {
          "name": "domain",
          "paths": [
            "internal/domain/**"
          ],
          "imports": [
            "^example\\.com/app/internal/domain\\b"
          ],
          "may_depend_on": [],
          "forbid": [
            {
              "pattern": "\\btime\\.Now\\(",
              "reason": "domain logic takes time as input"
            },
            {
              "pattern": "\"net/http\"",
              "reason": "the domain does no I/O"
            }
          ]
        },
        {
          "name": "infra",
          "paths": [
            "internal/infra/**"
          ],
          "imports": [
            "^example\\.com/app/internal/infra\\b"
          ],
          "may_depend_on": [
            "domain"
          ],
          "forbid": []
        }
      ],
      "exclude": [
        "tests/**",
        "**/tests/**",
        "test/**",
        "**/test/**"
      ]
    },
    "coverage": {
      "command": "go test -coverprofile=cover.out ./... && gocover-cobertura < cover.out > coverage.xml",
      "report": "coverage.xml",
      "format": "cobertura",
      "globs": [],
      "unmeasured_ok": [],
      "ok_exits": [
        0
      ],
      "requires": [
        "go",
        "gocover-cobertura"
      ],
      "install": "go install github.com/boumenot/gocover-cobertura@latest",
      "timeout": 3600
    },
    "mutation": {
      "command": "gremlins unleash ./...",
      "report": "",
      "format": "regex",
      "survivor_regex": "(?m)^\\s*LIVED\\s+(?P<mutation>\\S+)\\s+at\\s+(?P<file>[^:\\s]+):(?P<line>\\d+):\\d+",
      "ok_exits": [
        0
      ],
      "globs": [],
      "requires": [
        "gremlins"
      ],
      "install": "go install github.com/go-gremlins/gremlins/cmd/gremlins@latest",
      "timeout": 3600
    },
    "checks": [
      {
        "name": "docs",
        "command": "revive -formatter default ./...",
        "violation_regex": "(?m)^(?P<file>[^:\\n]+\\.go):(?P<line>\\d+):\\d+: (?P<message>exported .+)$",
        "baseline": true,
        "requires": [
          "revive"
        ],
        "install": "go install github.com/mgechev/revive@latest",
        "timeout": 600,
        "ok_exits": [
          0
        ]
      },
      {
        "name": "unused-deps",
        "command": "go mod tidy -diff",
        "violation_regex": "(?m)^--- (?:current/)?(?P<file>go\\.mod)$|^-\\t(?P<message>\\S+ v\\S+)",
        "baseline": true,
        "requires": [
          "go"
        ],
        "install": "Go 1.23 or later",
        "timeout": 600,
        "ok_exits": [
          0,
          1
        ]
      },
      {
        "name": "flaky",
        "command": "gotestsum --rerun-fails=2 --packages=./... --format testname",
        "violation_regex": "(?m)^PASS (?P<file>\\S+)\\.(?P<message>Test\\w*) \\(re-run \\d+\\)",
        "baseline": false,
        "requires": [
          "gotestsum"
        ],
        "install": "go install gotest.tools/gotestsum@latest",
        "timeout": 3600,
        "ok_exits": [
          0,
          1
        ]
      }
    ],
    "secrets": {
      "gitleaks": true,
      "patterns": [],
      "allow_globs": []
    },
    "hooks": {
      "types": [
        "build",
        "chore",
        "ci",
        "docs",
        "feat",
        "fix",
        "perf",
        "refactor",
        "revert",
        "style",
        "test"
      ],
      "scope_regex": "",
      "required_trailers": [
        "^Co-Authored-By: .+ <.+>$"
      ],
      "required_trailers_env": "CLAUDECODE",
      "pre_commit": [
        {
          "name": "gofmt",
          "command": "test -z \"$(gofmt -l {files})\"",
          "glob": "*.go",
          "timeout": 60
        }
      ],
      "commit_tests": true,
      "skip_tests_for_types": [
        "test"
      ],
      "test_timeout": 300,
      "budget_seconds": 60
    }
  },
  "tests": {
    "run": "go test ./...",
    "run_component": "go test ./.../{component}/...",
    "red_check": ""
  },
  "sources": {
    "kind": "product-requirements",
    "description": "docs/REQUIREMENTS.md is the normative source; sections are numbered.",
    "citation_format": "(Source: REQUIREMENTS §<section>)",
    "lookup_command": "",
    "text_dir": "docs/requirements",
    "heading_regex": "^#+\\s+{clause}\\b"
  },
  "protected_paths": [
    {
      "glob": "docs/CONSTITUTION.md",
      "reason": "the constitution changes only via a human-approved ADR"
    },
    {
      "glob": ".claude/**",
      "reason": "agent, skill, hook and workflow configuration is human-owned"
    },
    {
      "glob": "sdd.config.json",
      "reason": "the SDD configuration is human-owned"
    },
    {
      "glob": "docs/requirements/**",
      "reason": "the normative source is read-only"
    }
  ],
  "append_only_paths": [
    {
      "glob": "**/testdata/**",
      "allowed_roles": [
        "test-author"
      ],
      "reason": "testdata fixtures are immutable; test-author may only add NEW files with provenance"
    }
  ],
  "role_write_scopes": {
    "spec-author": [
      "specs/features/**"
    ],
    "architect-planner": [
      "specs/features/**"
    ],
    "product-owner": [
      "specs/features/**"
    ],
    "integrator": [
      "specs/features/**",
      "go.sum"
    ]
  },
  "role_denied_paths": {
    "implementer": [
      "**/*_test.go",
      "**/testdata/**",
      "tools/sdd/githooks/**",
      "tools/sdd/sddkit/**",
      "tools/sdd/sdd.py"
    ],
    "test-author": [
      "tools/sdd/githooks/**",
      "tools/sdd/sddkit/**",
      "tools/sdd/sdd.py"
    ]
  },
  "formatters": [
    {
      "glob": "*.go",
      "command": "gofmt -w {file}"
    }
  ],
  "build_cache": {
    "env": {}
  },
  "stop_check": {
    "command": "go build ./...",
    "changed_globs": [
      "*.go",
      "go.mod"
    ],
    "roles": [
      "implementer"
    ],
    "timeout": 240
  },
  "models": {
    "mechanical": "",
    "mid": "",
    "strong": "",
    "top": ""
  },
  "pipeline": {
    "max_parallel_features": 2,
    "max_critic_fix_rounds": 2,
    "max_gate_fix_rounds": 3,
    "skeptics": 2,
    "max_build_jobs": 4,
    "gate_poll_seconds": 120,
    "security_sensitive_hint": "authentication, authorization, cryptography, secrets, session or token handling, parsing of untrusted input"
  },
  "merge": {
    "union_manifests": [
      "go.mod"
    ],
    "lockfiles": [
      "go.sum"
    ],
    "after_union": "go mod tidy"
  },
  "commit": {
    "trailers": [
      "Co-Authored-By: <agent> <noreply@example.com>"
    ],
    "scope_format": "{feature}"
  },
  "override_env": "SDD_ALLOW_PROTECTED"
}
